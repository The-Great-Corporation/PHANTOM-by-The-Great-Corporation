+            imageVector = if (isSuccess) Icons.Default.Check else Icons.Default.Close,
+            contentDescription = null,
+            tint = if (isSuccess) Color(0xFF00E676) else Color(0xFFFF5252),
+            modifier = Modifier.size(18.dp)
+        )
+    }
